# Copy to .env and fill in. NEVER commit .env. Percentages are in PERCENT units (30 = 30%),
# money in MAJOR units (3.00 = three units of STORE_CURRENCY).

# ---- App -------------------------------------------------------------------
APP_ENV=development                 # development | test | production
SECRET_KEY=                         # >=32 random chars in production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
PUBLIC_BASE_URL=http://localhost:5000   # https://your-domain in production
CORS_ALLOWED_ORIGINS=               # comma-separated; empty = same-origin only
TRUST_PROXY=false                   # true when behind a reverse proxy / load balancer
STORE_NAME=Sniff Garden             # placeholder store identity - change me
STORE_CURRENCY=USD
MAX_QUANTITY_PER_ORDER_LINE=5

# ---- Database --------------------------------------------------------------
# Dev default (if empty): sqlite file in ./data.   Production: PostgreSQL.
DATABASE_URL=
AUTO_MIGRATE=                       # empty = true in dev, false in production (run migrations explicitly)

# ---- Admin -----------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=                # python -m backend.auth.hash_password
ADMIN_TOKEN_TTL_MINUTES=60

# ---- Payments --------------------------------------------------------------
PAYMENT_PROVIDER=sandbox            # sandbox (dev only) | stripe
PAYMENT_MODE=test                   # test | live   (production requires live)
PAYMENT_SECRET_KEY=                 # provider secret key (server only)
PAYMENT_WEBHOOK_SECRET=             # provider webhook signing secret

# ---- Supplier --------------------------------------------------------------
SUPPLIER_MODE=mock                  # mock (dev only) | manual (no API, admin-maintained) | 1688
SUPPLIER_1688_API_KEY=
SUPPLIER_1688_API_SECRET=
SUPPLIER_1688_ACCESS_TOKEN=
SUPPLIER_FX_RATE=0.14               # store-currency per 1 CNY. SAMPLE VALUE - set the real rate.
SUPPLIER_CHECK_POLICY=strict        # strict: block checkout if supplier cannot be verified | cache: allow fresh cache
STOCK_CACHE_MAX_AGE_MINUTES=15
FULFILLMENT_MODE=manual             # manual | automatic (automatic needs SUPPLIER_MODE=1688 + real adapter)

# ---- Pricing (internal, never sent to customers) ----------------------------
# STARTING VALUES - decide your own economics.
TARGET_MARGIN=30                    # % of selling price kept as profit
PAYMENT_FEE_PERCENT=2.9
PAYMENT_FIXED_FEE=0.30
REFUND_RESERVE_PERCENT=5
AD_COST_ALLOWANCE=3.00              # per unit sold
MIN_ACCEPTABLE_MARGIN=10            # below this %, checkout is blocked / product flagged
PRICE_REVIEW_THRESHOLD_PERCENT=10   # supplier price move that flags a product for admin review
PRICE_ENDING_CENTS=99               # prices round UP to end in .99 ; empty = off

# ---- Misc ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
